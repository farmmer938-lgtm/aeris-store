{
  "openapi": "3.1.0",
  "info": {
    "title": "AERIS MUSIC public catalog",
    "version": "1.1.0",
    "description": "The paid storefront catalog is temporarily closed pending audio-quality, licensing, and end-to-end delivery verification. This API does not advertise paid products."
  },
  "servers": [
    {
      "url": "https://farmmer938-lgtm.github.io/aeris-store"
    }
  ],
  "paths": {
    "/agents/catalog.json": {
      "get": {
        "operationId": "getPaidCatalogStatus",
        "summary": "Read current paid catalog status",
        "responses": {
          "200": {
            "description": "Current status; catalog is empty while quality gate is closed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "paid_catalog_status": {
                      "type": "string",
                      "enum": [
                        "CLOSED"
                      ]
                    },
                    "verified_revenue_usd": {
                      "type": "number"
                    },
                    "track_count": {
                      "type": "integer"
                    },
                    "catalog": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/free/": {
      "get": {
        "operationId": "listFreeCC0Tracks",
        "summary": "Open the free CC0 catalog",
        "responses": {
          "200": {
            "description": "Public free music page with direct downloads"
          }
        }
      }
    }
  }
}
